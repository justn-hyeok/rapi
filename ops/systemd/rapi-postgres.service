[Unit]
Description=Rapi PostgreSQL readiness gate
Requires=docker.service
After=docker.service
Before=rapi-bot.service rapi-monitor.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/justn/rapi
ExecStart=/usr/bin/docker compose --project-name rapi --file /home/justn/rapi/compose.yaml up --detach --no-build --pull never --wait --wait-timeout 120 postgres
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
