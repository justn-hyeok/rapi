[Unit]
Description=Redhood independent health monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=justn
WorkingDirectory=/home/justn/redhood
ExecStart=/usr/local/bin/npm run start:monitor
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/redhood

[Install]
WantedBy=multi-user.target
