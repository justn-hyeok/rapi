[Unit]
Description=Redhood Discord bot and webhook API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=10

[Service]
Type=simple
User=justn
WorkingDirectory=/home/justn/redhood
ExecStart=/usr/local/bin/npm run start:bot
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/justn/redhood /var/lib/redhood
SupplementaryGroups=redhood

[Install]
WantedBy=multi-user.target
