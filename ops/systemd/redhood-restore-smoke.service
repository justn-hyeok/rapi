[Unit]
Description=Weekly Redhood backup restore verification
After=docker.service redhood-backup.service
Requires=docker.service

[Service]
Type=oneshot
User=justn
Group=docker
WorkingDirectory=/home/justn/redhood
EnvironmentFile=/home/justn/redhood/.env
Environment=RESTORE_LATEST_BACKUP=true
Environment=RESTORE_SMOKE_PROJECT=redhood-restore-weekly
Environment=RESTORE_SMOKE_DATABASE=redhood_restore_smoke_weekly
ExecStart=/home/justn/redhood/scripts/restore-smoke.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
