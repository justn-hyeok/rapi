[Unit]
Description=Redhood PostgreSQL backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=justn
WorkingDirectory=/home/justn/redhood-releases/current
EnvironmentFile=/home/justn/redhood/.env
Environment=REDHOOD_BACKUP_DIRECTORY=/home/justn/redhood/backups
Environment=BACKUP_STATUS_FILE=/home/justn/redhood/backups/backup-status.json
Environment=BACKUP_RETENTION_DAYS=30
ExecStart=/bin/bash /home/justn/redhood-releases/current/scripts/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/justn/redhood/backups /var/lib/redhood
