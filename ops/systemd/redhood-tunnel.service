[Unit]
Description=Redhood public Discord interaction tunnel
After=network-online.target redhood-public-gateway.service
Wants=network-online.target
Requires=redhood-public-gateway.service

[Service]
Type=simple
User=justn
WorkingDirectory=/home/justn/redhood
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /var/lib/redhood/cloudflared/config.yml tunnel run
Restart=always
RestartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/redhood/cloudflared

[Install]
WantedBy=multi-user.target
