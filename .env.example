RAPI_ENV=
RAPI_LOG_LEVEL=
PORT=
DATABASE_URL=
MIGRATION_DATABASE_URL=
RAPI_RUNTIME_DATABASE_ROLE=
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_ALLOWED_USER_IDS=
DISCORD_SUPERADMIN_USER_IDS=
DISCORD_ADMIN_USER_IDS=
DISCORD_USER_IDS=
DISCORD_ADMIN_ROLE_IDS=
DISCORD_USER_ROLE_IDS=
DISCORD_GUILD_MEMBERS_ARE_USERS=false
DISCORD_ALLOWED_GUILD_IDS=
# Optional: operator guild; defaults to COMMUNITY_GUILD_ID, then the first allowed guild.
# With no home, allowed or approved guild, every server is refused.
DISCORD_HOME_GUILD_ID=
DISCORD_ALLOWED_CHANNEL_IDS=
REGISTER_DISCORD_COMMANDS=
# Optional: without it the two GitHub candidate routes are skipped.
GITHUB_READ_TOKEN=
# Optional: the channel only the owner reads, in an allowed server. Without it no
# discount card or server request card is sent.
# DISCOUNT_REVIEW_CHANNEL_ID=
# Optional: where [게시] sends a card. Without it the review card buttons refuse.
# DISCOUNT_PUBLIC_CHANNEL_ID=
# Optional: give a kind of notification its own channel. Without one it goes to the
# channel above for that side, review or public.
# NEW_SERVICE_REVIEW_CHANNEL_ID=
# NEW_SERVICE_PUBLIC_CHANNEL_ID=
# REPORT_REVIEW_CHANNEL_ID=
# GUILD_REQUEST_REVIEW_CHANNEL_ID=
# Optional: whose GitHub stars to remind. Goes to the first DISCORD_SUPERADMIN_USER_IDS
# by DM; without both, nothing is read or sent.
# STAR_REMINDER_GITHUB_USER=
POLL_INTERVAL_SECONDS=
COMMUNITY_GUILD_ID=
# 32 random bytes in base64; encrypts the operations webhook URL
WEBHOOK_ENCRYPTION_KEY=
# Fixed HTTPS origin of the public gateway
RAPI_PUBLIC_BASE_URL=
PUBLIC_TUNNEL_VERIFIED_FILE=/var/lib/rapi/tunnel-verified.json
OPERATIONS_CHANNEL_ID=
OPERATIONS_DISCORD_WEBHOOK_CIPHERTEXT=
MONITOR_STATE_FILE=/var/lib/rapi/monitor-state.json
BACKUP_STATUS_FILE=backups/backup-status.json
DATABASE_SIZE_LIMIT_BYTES=500000000
MONITOR_INTERVAL_SECONDS=30
MONITOR_PORT=4300
PUBLIC_GATEWAY_READY_URL=http://127.0.0.1:4601/ready
CLOUDFLARE_TUNNEL_READY_URL=http://127.0.0.1:4700/ready
DISCORD_LAYOUT_FILE=/home/justn/rapi/config/discord-channels.yaml
BOT_READY_URL=http://127.0.0.1:4000/ready
CLOUDFLARE_TUNNEL_TOKEN=
RAPI_BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=30
# Optional: direct model calls through one client (off unless both BASE_URL and KEY are set).
# Plain http is loopback only.
# MODEL_API_BASE_URL=
# MODEL_API_KEY=
# MODEL_DEFAULT=
# MODEL_FOR_SUMMARY=
# Monthly cap in USD (calendar month, Asia/Seoul). Unset = metering only.
# MODEL_MONTHLY_BUDGET_USD=
# Fallback prices when the gateway reports no cost (default ops/model-prices.json).
# MODEL_PRICES_FILE=
# Summaries via the API client instead of the codex CLI (default codex).
# SUMMARIZER_BACKEND=codex
